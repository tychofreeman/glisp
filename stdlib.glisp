(def mult_recur (lambda (fn x y sum) (if (eq 0 x) sum (fn fn (plus -1 x) y (plus y sum)))))
(def mult (lambda (x y) (* x y)))

; (defn name (params...) body...) is (def name (lambda (params...) body...)).
(defmacro defn (lambda (xs)
  (cons (quote def)
    (cons (car xs)
      (cons (cons (quote lambda) (cdr xs)) nil)))))

; (let (name value name value ...) body...) binds each name to its value, in
; order, so a value can use the names before it, then evaluates body.
; (let (a 1 b a) body) is ((lambda (a) ((lambda (b) ((lambda () body))) a)) 1).
(defn let_expand (bindings body)
  (if (eq (car bindings) nil)
    (cons (cons (quote lambda) (cons (quote ()) body)) nil)
    (cons
      (cons (quote lambda)
        (cons (cons (car bindings) nil)
          (cons (cons (quote let) (cons (cdr (cdr bindings)) body)) nil)))
      (cons (car (cdr bindings)) nil))))
(defmacro let (lambda (xs) (let_expand (car xs) (cdr xs))))

; (not x) is true unless x is true, the one value if takes as true.
(defn not (x) (if x false true))

; (and a b ...) is the last of its arguments if all before it are true, and
; false as soon as one isn't, without evaluating the rest. (and) is true.
(defn and_expand (xs)
  (if (eq xs (quote ())) (quote true)
    (if (eq (cdr xs) (quote ())) (car xs)
      (cons (quote if) (cons (car xs) (cons (and_expand (cdr xs)) (cons (quote false) nil)))))))
(defmacro and (lambda (xs) (and_expand xs)))

; (or a b ...) is true as soon as one of its arguments is true, without
; evaluating the rest, and otherwise the last. (or) is false.
(defn or_expand (xs)
  (if (eq xs (quote ())) (quote false)
    (if (eq (cdr xs) (quote ())) (car xs)
      (cons (quote if) (cons (car xs) (cons (quote true) (cons (or_expand (cdr xs)) nil)))))))
(defmacro or (lambda (xs) (or_expand xs)))

; (cond (test body...) ...) is the body of the first clause whose test is
; true, or nil if none is. A test of else always is.
(defn cond_test (test) (if (eq test (quote else)) (quote true) test))
(defn cond_body (body)
  (if (eq body (quote ())) (quote nil)
    (if (eq (cdr body) (quote ())) (car body)
      (cons (cons (quote lambda) (cons (quote ()) body)) nil))))
(defn cond_expand (clauses)
  (if (eq clauses (quote ())) (quote nil)
    (cons (quote if)
      (cons (cond_test (car (car clauses)))
        (cons (cond_body (cdr (car clauses)))
          (cons (cond_expand (cdr clauses)) nil))))))
(defmacro cond (lambda (clauses) (cond_expand clauses)))

; A list library. Each function takes nil or () as the empty list, gives ()
; for an empty result, and runs in constant stack.

; (list a b ...) is the list of its arguments.
(defn list items items)

; (empty? l) is true if l is nil or the empty list.
(defn empty? (l) (or (eq l nil) (eq l (quote ()))))

; (fold f acc l) is (f (f (f acc a) b) c) for l = (a b c).
(defn fold (f acc l)
  (if (empty? l) acc (fold f (f acc (car l)) (cdr l))))

(defn reverse (l) (fold (lambda (acc x) (cons x acc)) (quote ()) l))

; (foldr f init l) is (f a (f b (f c init))) for l = (a b c).
(defn foldr (f init l) (fold (lambda (acc x) (f x acc)) init (reverse l)))

(defn map (f l) (reverse (fold (lambda (acc x) (cons (f x) acc)) (quote ()) l)))

(defn filter (keep l)
  (reverse (fold (lambda (acc x) (if (keep x) (cons x acc) acc)) (quote ()) l)))

(defn length (l) (fold (lambda (n x) (plus n 1)) 0 l))

(defn append (a b) (foldr cons b a))

(defn identity (x) x)

; ((compose f g) x) is (f (g x)); (compose) is identity.
(defn compose fs (foldr (lambda (f g) (lambda (x) (f (g x)))) identity fs))

; ((partial f a) b) is (f a b).
(defn partial (f . args) (lambda more (apply f (append args more))))

; (deftype type (constructor field ...) ...) defines an algebraic data type:
; for each constructor, a function that makes a data value of it, a
; predicate constructor?, and constructor_field for each field; and a
; predicate type?. Its expansion is a begin of defs.
(defn deftype_name (parts) (symbol (apply str parts)))
(defn deftype_article (name)
  (if (deftype_member (car (chars (str name))) (chars "aeiou")) "an " "a "))
(defn deftype_member (x l)
  (if (empty? l) false (if (eq x (car l)) true (deftype_member x (cdr l)))))
(defn deftype_quote (x) (list (quote quote) x))
(defn deftype_constructor (c)
  (if (and (list? c) (not (empty? c)) (symbol? (car c)))
    c
    (error "deftype: expected (constructor field ...), got " c)))
(defn deftype_make (c)
  (list (quote def) (car c)
    (list (quote lambda) (cdr c)
      (cons (quote data) (cons (deftype_quote (car c)) (cdr c))))))
(defn deftype_is (c)
  (list (quote def) (deftype_name (list (car c) "?"))
    (list (quote lambda) (quote (x))
      (list (quote and) (quote (data? x))
        (list (quote eq) (quote (data_name x)) (deftype_quote (car c)))))))
(defn deftype_fields (name fields i)
  (if (empty? fields) (quote ())
    (let (getter (deftype_name (list name "_" (car fields))))
      (cons
        (list (quote def) getter
          (list (quote lambda) (quote (x))
            (list (quote if) (list (deftype_name (list name "?")) (quote x))
              (list (quote data_ref) (quote x) i)
              (list (quote error)
                (str getter ": expected " (deftype_article name) name ", got ")
                (quote x)))))
        (deftype_fields name (cdr fields) (plus i 1))))))
(defn deftype_type (type constructors)
  (list (quote def) (deftype_name (list type "?"))
    (list (quote lambda) (quote (x))
      (cons (quote or)
        (map (lambda (c) (list (deftype_name (list (car c) "?")) (quote x)))
             constructors)))))
(defn deftype_expand (xs)
  (if (not (symbol? (car xs)))
    (error "deftype: expected a type name, got " (car xs))
    (let (constructors (map deftype_constructor (cdr xs)))
      (cons (quote begin)
        (append
          (fold (lambda (defs c)
                  (append defs
                    (cons (deftype_make c)
                      (cons (deftype_is c) (deftype_fields (car c) (cdr c) 0)))))
                (quote ()) constructors)
          (list (deftype_type (car xs) constructors)))))))
(defmacro deftype (lambda (xs) (deftype_expand xs)))

; (cons? x) is true if x is a list with at least one element.
(defn cons? (x) (and (list? x) (not (empty? x))))

; (match x (pattern body...) ...) is the body of the first clause whose
; pattern matches x's value, with the pattern's names bound. A clause
; becomes (if tests (let bindings body...) next): match_compile gives a
; pattern's tests, in the order they may run, and its bindings, each a
; (name path) list, where a path is the code that reaches a part of the
; value from __match.
(defn match_compile (pat path)
  (cond ((eq pat (quote _)) (list (quote ()) (quote ())))
        ((or (eq pat (quote true)) (eq pat (quote false)) (eq pat (quote nil))
             (number? pat) (string? pat))
         (list (list (list (quote eq) path pat)) (quote ())))
        ((symbol? pat) (list (quote ()) (list (list pat path))))
        ((empty? pat) (list (list (list (quote empty?) path)) (quote ())))
        ((list? pat) (match_compound (car pat) (cdr pat) path))
        (else (error "match: not a pattern: " pat))))
(defn match_compound (head pats path)
  (cond ((eq head (quote quote))
         (list (list (list (quote eq) path (list (quote quote) (car pats)))) (quote ())))
        ((eq head (quote list)) (match_list pats path))
        ((eq head (quote cons))
         (if (eq (length pats) 2)
           (match_join (list (list (list (list (quote cons?) path)) (quote ()))
                             (match_compile (car pats) (list (quote car) path))
                             (match_compile (car (cdr pats)) (list (quote cdr) path))))
           (error "match: cons takes a head and a tail, got " (cons head pats))))
        ((eq head (quote vector))
         (match_parts (list (list (quote vector?) path)
                            (list (quote eq) (list (quote vector_length) path) (length pats)))
                      pats (lambda (i) (list (quote vector_ref) path i))))
        ((symbol? head)
         (match_parts (list (list (quote data?) path)
                            (list (quote eq) (list (quote data_name) path) (list (quote quote) head))
                            (list (quote eq) (list (quote data_length) path) (length pats)))
                      pats (lambda (i) (list (quote data_ref) path i))))
        (else (error "match: not a pattern: " (cons head pats)))))
(defn match_list (pats path)
  (if (empty? pats)
    (list (list (list (quote empty?) path)) (quote ()))
    (match_join (list (list (list (list (quote cons?) path)) (quote ()))
                      (match_compile (car pats) (list (quote car) path))
                      (match_list (cdr pats) (list (quote cdr) path))))))
; match_parts is tests, then pats each matched against (part i).
(defn match_parts (tests pats part)
  (match_join (cons (list tests (quote ())) (match_each pats part 0))))
(defn match_each (pats part i)
  (if (empty? pats) (quote ())
    (cons (match_compile (car pats) (part i)) (match_each (cdr pats) part (plus i 1)))))
; match_join is the tests and bindings of results, each (tests bindings), in order.
(defn match_join (results)
  (fold (lambda (acc r) (list (append (car acc) (car r)) (append (car (cdr acc)) (car (cdr r)))))
        (list (quote ()) (quote ())) results))
(defn match_unique (bindings)
  (if (empty? bindings) true
    (if (empty? (filter (lambda (b) (eq (car b) (car (car bindings)))) (cdr bindings)))
      (match_unique (cdr bindings))
      (error "match: " (car (car bindings)) " appears twice in a pattern"))))
(defn match_clause (clause next)
  (if (not (cons? clause))
    (error "match: expected (pattern body...), got " clause)
    (let (compiled (match_compile (car clause) (quote __match))
          bindings (car (cdr compiled)))
      (match_unique bindings)
      (list (quote if) (cons (quote and) (car compiled))
        (cons (quote let) (cons (fold append (quote ()) bindings) (cdr clause)))
        next))))
(defn match_clauses (clauses)
  (if (empty? clauses)
    (quote (error "match: no clause matches " __match))
    (match_clause (car clauses) (match_clauses (cdr clauses)))))
(defn match_expand (xs)
  (if (empty? xs)
    (error "match: expected a value and clauses")
    (list (list (quote lambda) (quote (__match)) (match_clauses (cdr xs))) (car xs))))
(defmacro match (lambda (xs) (match_expand xs)))

; Errors as values: a function that can fail returns a maybe, a value or
; none, or an either, a failure (left) or a value (right).
(deftype maybe (just value) (nothing))
(deftype either (left value) (right value))

; (bind m f) chains f after m: for (just x) or (right x), (f x); for
; (nothing) or a left, m; for a list, the lists f gives for its elements,
; appended.
(defn bind (m f)
  (match m
    ((just x) (f x))
    ((right x) (f x))
    ((nothing) m)
    ((left _) m)
    (() (quote ()))
    ((cons _ _) (foldr (lambda (x rest) (append (f x) rest)) (quote ()) m))
    (_ (error "bind: expected a maybe, an either or a list, got " m))))

; (do step ... result) chains its steps through bind: (x <- m) binds x to
; what m gives for the steps after it; any other step goes on whatever it
; gives; result is the chain's value.
(defn do_binding? (step)
  (and (cons? step) (cons? (cdr step)) (eq (car (cdr step)) (quote <-))))
(defn do_expand (steps)
  (cond ((empty? steps) (error "do: expected at least one step"))
        ((do_binding? (car steps))
         (let (step (car steps))
           (cond ((empty? (cdr steps)) (error "do: the last step can't bind a name: " step))
                 ((not (and (symbol? (car step)) (eq (length step) 3)))
                  (error "do: expected (name <- value), got " step))
                 (else (list (quote bind) (car (cdr (cdr step)))
                         (list (quote lambda) (list (car step)) (do_expand (cdr steps))))))))
        ((empty? (cdr steps)) (car steps))
        (else (list (quote bind) (car steps)
                (list (quote lambda) (quote (_)) (do_expand (cdr steps)))))))
(defmacro do (lambda (steps) (do_expand steps)))
