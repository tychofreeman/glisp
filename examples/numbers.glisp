; A tour of glisp: list functions, sorting and a little number theory,
; built from the handful of builtins.  Run it with
;   go run ./cmd/glisp examples/numbers.glisp

(def true (eq 1 1))
(def false (eq 1 2))
(def nil (car (quote ())))
(def empty (quote ()))

(def null (lambda (l) (eq (car l) nil)))
(def not (lambda (b) (if b false true)))
(def inc (lambda (n) (plus n 1)))
(def dec (lambda (n) (- n 1)))

(def mod (lambda (a b)
  (if (< a b) a (mod (- a b) b))))

(def half_walk (lambda (n i)
  (if (eq (plus i i) n) i (half_walk n (inc i)))))
(def half (lambda (n) (half_walk n 0)))

(def range (lambda (a b)
  (if (eq a (inc b)) empty
    (cons a (range (inc a) b)))))

(def length (lambda (l)
  (if (null l) 0 (inc (length (cdr l))))))

(def map (lambda (f l)
  (if (null l) empty
    (cons (f (car l)) (map f (cdr l))))))

(def filter (lambda (pred l)
  (if (null l) empty
    (if (pred (car l))
      (cons (car l) (filter pred (cdr l)))
      (filter pred (cdr l))))))

(def fold (lambda (f acc l)
  (if (null l) acc
    (fold f (f acc (car l)) (cdr l)))))

(def add (lambda (a b) (plus a b)))
(def sum (lambda (l) (fold add 0 l)))

(def push (lambda (acc x) (cons x acc)))
(def reverse (lambda (l) (fold push empty l)))

(def append (lambda (a b)
  (if (null a) b
    (cons (car a) (append (cdr a) b)))))

(def insert (lambda (x sorted)
  (if (null sorted) (cons x empty)
    (if (< x (car sorted))
      (cons x sorted)
      (cons (car sorted) (insert x (cdr sorted)))))))
(def insert_into (lambda (acc x) (insert x acc)))
(def sort (lambda (l) (fold insert_into empty l)))

(def square (lambda (n) (mult n n)))
(def even (lambda (n) (eq (mod n 2) 0)))
(def odd (lambda (n) (not (even n))))

(def fact (lambda (n)
  (if (eq n 0) 1 (mult n (fact (dec n))))))

(def fib (lambda (n)
  (if (< n 2) n
    (plus (fib (dec n)) (fib (- n 2))))))

(def gcd (lambda (a b)
  (if (eq b 0) a (gcd b (mod a b)))))

(def divides (lambda (d n) (eq (mod n d) 0)))
(def no_divisor (lambda (n d)
  (if (eq d n) true
    (if (divides d n) false (no_divisor n (inc d))))))
(def prime (lambda (n)
  (if (< n 2) false (no_divisor n 2))))

(def collatz_next (lambda (n)
  (if (even n) (half n) (inc (plus n (plus n n))))))
(def collatz_steps (lambda (n)
  (if (eq n 1) 0 (inc (collatz_steps (collatz_next n))))))

(def scramble (lambda (n) (mod (plus 7 (mult n 13)) 31)))

(p "range 1..10:" (range 1 10))
(p "squares:" (map square (range 1 10)))
(p "evens, odds:" (filter even (range 1 10)) (filter odd (range 1 10)))
(p "sum of squares of evens:" (sum (map square (filter even (range 1 10)))))
(p "reverse:" (reverse (range 1 8)))
(p "append:" (append (range 1 3) (range 7 9)))
(p "fib 0..15:" (map fib (range 0 15)))
(p "10 factorial:" (fact 10))
(p "gcd 1071 462:" (gcd 1071 462))
(p "primes up to 60:" (filter prime (range 1 60)))
(p "count of primes up to 60:" (length (filter prime (range 1 60))))
(p "collatz steps 1..12:" (map collatz_steps (range 1 12)))
(p "collatz steps for 27:" (collatz_steps 27))
(def unsorted (map scramble (range 1 15)))
(p "unsorted:" unsorted)
(p "sorted:" (sort unsorted))
(sum (sort unsorted))
