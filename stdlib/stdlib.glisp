(def mult_recur (lambda (fn x y sum) (if (eq 0 x) sum (fn fn (plus -1 x) y (plus y sum)))))
(def mult (lambda (x y) (* x y)))

; (defn name (params...) body...) is (def name (lambda (params...) body...)).
(defmacro defn (lambda (xs) `(def ,(car xs) (lambda ,@(cdr xs)))))

; (let (name value name value ...) body...) binds each name to its value, in
; order, so a value can use the names before it, then evaluates body.
; (let (a 1 b a) body) is ((lambda (a) ((lambda (b) ((lambda () body))) a)) 1).
(defn let_expand (bindings body)
  (if (eq (car bindings) nil)
    `((lambda () ,@body))
    `((lambda (,(car bindings)) (let ,(cdr (cdr bindings)) ,@body)) ,(car (cdr bindings)))))
(defmacro let (lambda (xs) (let_expand (car xs) (cdr xs))))

; (not x) is true unless x is true, the one value if takes as true.
(defn not (x) (if x false true))

; (and a b ...) is the last of its arguments if all before it are true, and
; false as soon as one isn't, without evaluating the rest. (and) is true.
(defn and_expand (xs)
  (if (eq xs (quote ())) (quote true)
    (if (eq (cdr xs) (quote ())) (car xs)
      `(if ,(car xs) ,(and_expand (cdr xs)) false))))
(defmacro and (lambda (xs) (and_expand xs)))

; (or a b ...) is true as soon as one of its arguments is true, without
; evaluating the rest, and otherwise the last. (or) is false.
(defn or_expand (xs)
  (if (eq xs (quote ())) (quote false)
    (if (eq (cdr xs) (quote ())) (car xs)
      `(if ,(car xs) true ,(or_expand (cdr xs))))))
(defmacro or (lambda (xs) (or_expand xs)))

; (cond (test body...) ...) is the body of the first clause whose test is
; true, or nil if none is. A test of else always is.
(defn cond_test (test) (if (eq test (quote else)) (quote true) test))
(defn cond_body (body)
  (if (eq body (quote ())) (quote nil)
    (if (eq (cdr body) (quote ())) (car body)
      `((lambda () ,@body)))))
(defn cond_expand (clauses)
  (if (eq clauses (quote ())) (quote nil)
    `(if ,(cond_test (car (car clauses)))
       ,(cond_body (cdr (car clauses)))
       ,(cond_expand (cdr clauses)))))
(defmacro cond (lambda (clauses) (cond_expand clauses)))

; A list library. Each function takes nil or () as the empty list, gives ()
; for an empty result, and runs in constant stack.

; (list a b ...) is the list of its arguments.
(defn list items items)

; (empty? l) is true if l is nil or the empty list.
(defn empty? (l) (or (eq l nil) (eq l (quote ()))))

; (fold f acc l) is (f (f (f acc a) b) c) for l = (a b c).
(defn fold (f acc l)
  (if (empty? l) acc (fold f (f acc (car l)) (cdr l))))

(defn reverse (l) (fold (lambda (acc x) (cons x acc)) (quote ()) l))

; (foldr f init l) is (f a (f b (f c init))) for l = (a b c).
(defn foldr (f init l) (fold (lambda (acc x) (f x acc)) init (reverse l)))

(defn map (f l) (reverse (fold (lambda (acc x) (cons (f x) acc)) (quote ()) l)))

(defn filter (keep l)
  (reverse (fold (lambda (acc x) (if (keep x) (cons x acc) acc)) (quote ()) l)))

(defn length (l) (fold (lambda (n x) (plus n 1)) 0 l))

(defn append (a b) (foldr cons b a))

(defn identity (x) x)

; ((compose f g) x) is (f (g x)); (compose) is identity.
(defn compose fs (foldr (lambda (f g) (lambda (x) (f (g x)))) identity fs))

; ((partial f a) b) is (f a b).
(defn partial (f . args) (lambda more (apply f (append args more))))

; (letrec (name value ...) body...) is let whose values can use every name
; it binds, its own included, for functions that call themselves or each
; other: the names are defined in turn in a new scope, then body runs there.
(defn letrec_defs (bindings)
  (cond ((empty? bindings) (quote ()))
        ((empty? (cdr bindings)) (error "letrec: expected names and values in pairs, got " bindings))
        (else (cons `(def ,(car bindings) ,(car (cdr bindings)))
                    (letrec_defs (cdr (cdr bindings)))))))
(defmacro letrec (lambda (xs) `((lambda () ,@(letrec_defs (car xs)) ,@(cdr xs)))))

; (deftype type (constructor field ...) ...) defines an algebraic data type:
; for each constructor, a function that makes a data value of it, a
; predicate constructor?, and constructor_field for each field; and a
; predicate type?. Its expansion is a begin of defs.
(defn deftype_name (parts) (symbol (apply str parts)))
(defn deftype_article (name)
  (if (deftype_member (car (chars (str name))) (chars "aeiou")) "an " "a "))
(defn deftype_member (x l)
  (if (empty? l) false (if (eq x (car l)) true (deftype_member x (cdr l)))))
(defn deftype_quote (x) (list (quote quote) x))
(defn deftype_constructor (c)
  (if (and (list? c) (not (empty? c)) (symbol? (car c)))
    c
    (error "deftype: expected (constructor field ...), got " c)))
(defn deftype_make (c)
  `(def ,(car c) (lambda ,(cdr c) (data (quote ,(car c)) ,@(cdr c)))))
(defn deftype_is (c)
  `(def ,(deftype_name (list (car c) "?"))
     (lambda (x#) (and (data? x#) (eq (data_name x#) (quote ,(car c)))))))
(defn deftype_fields (name fields i)
  (if (empty? fields) (quote ())
    (let (getter (deftype_name (list name "_" (car fields))))
      (cons
        `(def ,getter
           (lambda (x#)
             (if (,(deftype_name (list name "?")) x#)
               (data_ref x# ,i)
               (error ,(str getter ": expected " (deftype_article name) name ", got ") x#))))
        (deftype_fields name (cdr fields) (plus i 1))))))
(defn deftype_type (type constructors)
  `(def ,(deftype_name (list type "?"))
     (lambda (x) (or ,@(map (lambda (c) (list (deftype_name (list (car c) "?")) (quote x))) constructors)))))
(defn deftype_expand (xs)
  (if (not (symbol? (car xs)))
    (error "deftype: expected a type name, got " (car xs))
    (let (constructors (map deftype_constructor (cdr xs)))
      (cons (quote begin)
        (append
          (fold (lambda (defs c)
                  (append defs
                    (cons (deftype_make c)
                      (cons (deftype_is c) (deftype_fields (car c) (cdr c) 0)))))
                (quote ()) constructors)
          (list (deftype_type (car xs) constructors)))))))
(defmacro deftype (lambda (xs) (deftype_expand xs)))

; (cons? x) is true if x is a list with at least one element.
(defn cons? (x) (and (list? x) (not (empty? x))))

; (match x (pattern body...) ...) is the body of the first clause whose
; pattern matches x's value, with the pattern's names bound. A clause
; becomes (if tests (let bindings body...) next): match_compile gives a
; pattern's tests, in the order they may run, and its bindings, each a
; (name path) list, where a path is the code that reaches a part of the
; value from __match.
(defn match_compile (pat path)
  (cond ((eq pat (quote _)) (list (quote ()) (quote ())))
        ((or (eq pat (quote true)) (eq pat (quote false)) (eq pat (quote nil))
             (number? pat) (string? pat))
         (list (list (list (quote eq) path pat)) (quote ())))
        ((symbol? pat) (list (quote ()) (list (list pat path))))
        ((empty? pat) (list (list (list (quote empty?) path)) (quote ())))
        ((list? pat) (match_compound (car pat) (cdr pat) path))
        (else (error "match: not a pattern: " pat))))
(defn match_compound (head pats path)
  (cond ((eq head (quote quote))
         (list (list (list (quote eq) path (list (quote quote) (car pats)))) (quote ())))
        ((eq head (quote list)) (match_list pats path))
        ((eq head (quote cons))
         (if (eq (length pats) 2)
           (match_join (list (list (list (list (quote cons?) path)) (quote ()))
                             (match_compile (car pats) (list (quote car) path))
                             (match_compile (car (cdr pats)) (list (quote cdr) path))))
           (error "match: cons takes a head and a tail, got " (cons head pats))))
        ((eq head (quote vector))
         (match_parts (list (list (quote vector?) path)
                            (list (quote eq) (list (quote vector_length) path) (length pats)))
                      pats (lambda (i) (list (quote vector_ref) path i))))
        ((symbol? head)
         (match_parts (list (list (quote data?) path)
                            (list (quote eq) (list (quote data_name) path) (list (quote quote) head))
                            (list (quote eq) (list (quote data_length) path) (length pats)))
                      pats (lambda (i) (list (quote data_ref) path i))))
        (else (error "match: not a pattern: " (cons head pats)))))
(defn match_list (pats path)
  (if (empty? pats)
    (list (list (list (quote empty?) path)) (quote ()))
    (match_join (list (list (list (list (quote cons?) path)) (quote ()))
                      (match_compile (car pats) (list (quote car) path))
                      (match_list (cdr pats) (list (quote cdr) path))))))
; match_parts is tests, then pats each matched against (part i).
(defn match_parts (tests pats part)
  (match_join (cons (list tests (quote ())) (match_each pats part 0))))
(defn match_each (pats part i)
  (if (empty? pats) (quote ())
    (cons (match_compile (car pats) (part i)) (match_each (cdr pats) part (plus i 1)))))
; match_join is the tests and bindings of results, each (tests bindings), in order.
(defn match_join (results)
  (fold (lambda (acc r) (list (append (car acc) (car r)) (append (car (cdr acc)) (car (cdr r)))))
        (list (quote ()) (quote ())) results))
(defn match_unique (bindings)
  (if (empty? bindings) true
    (if (empty? (filter (lambda (b) (eq (car b) (car (car bindings)))) (cdr bindings)))
      (match_unique (cdr bindings))
      (error "match: " (car (car bindings)) " appears twice in a pattern"))))
(defn match_clause (clause next)
  (if (not (cons? clause))
    (error "match: expected (pattern body...), got " clause)
    (let (compiled (match_compile (car clause) (quote __match))
          bindings (car (cdr compiled)))
      (match_unique bindings)
      `(if (and ,@(car compiled))
         (let ,(fold append (quote ()) bindings) ,@(cdr clause))
         ,next))))
(defn match_clauses (clauses)
  (if (empty? clauses)
    (quote (error "match: no clause matches " __match))
    (match_clause (car clauses) (match_clauses (cdr clauses)))))
(defn match_expand (xs)
  (if (empty? xs)
    (error "match: expected a value and clauses")
    `((lambda (__match) ,(match_clauses (cdr xs))) ,(car xs))))
(defmacro match (lambda (xs) (match_expand xs)))

; Errors as values: a function that can fail returns a maybe, a value or
; none, or an either, a failure (left) or a value (right).
(deftype maybe (just value) (nothing))
(deftype either (left value) (right value))

; (bind m f) chains f after m: for (just x) or (right x), (f x); for
; (nothing) or a left, m; for a list, the lists f gives for its elements,
; appended.
(defn bind (m f)
  (match m
    ((just x) (f x))
    ((right x) (f x))
    ((nothing) m)
    ((left _) m)
    (() (quote ()))
    ((cons _ _) (foldr (lambda (x rest) (append (f x) rest)) (quote ()) m))
    (_ (error "bind: expected a maybe, an either or a list, got " m))))

; (do step ... result) chains its steps through bind: (x <- m) binds x to
; what m gives for the steps after it; any other step goes on whatever it
; gives; result is the chain's value.
(defn do_binding? (step)
  (and (cons? step) (cons? (cdr step)) (eq (car (cdr step)) (quote <-))))
(defn do_expand (steps)
  (cond ((empty? steps) (error "do: expected at least one step"))
        ((do_binding? (car steps))
         (let (step (car steps))
           (cond ((empty? (cdr steps)) (error "do: the last step can't bind a name: " step))
                 ((not (and (symbol? (car step)) (eq (length step) 3)))
                  (error "do: expected (name <- value), got " step))
                 (else `(bind ,(car (cdr (cdr step)))
                          (lambda (,(car step)) ,(do_expand (cdr steps))))))))
        ((empty? (cdr steps)) (car steps))
        (else `(bind ,(car steps) (lambda (_#) ,(do_expand (cdr steps)))))))
(defmacro do (lambda (steps) (do_expand steps)))

; Generic operations: functions with an instance for each type of value
; they take, typeclasses without types. (defgeneric name (param ...) on)
; defines name to fail for any value of on; (definstance name (param ...)
; body ...), with one parameter written (p type?), adds the instance for
; the values for which (type? p) holds. A later instance is tried first,
; so a program can add instances for its own types, or replace these.
(defmacro defgeneric (lambda (xs)
  `(defn ,(car xs) ,(car (cdr xs))
     (error ,(str (car xs) ": no instance for ") (show ,(car (cdr (cdr xs))))))))
(defn definstance_param (p) (if (cons? p) (car p) p))
(defn definstance_test (name params)
  (cond ((empty? params) (error "definstance: expected a parameter (name type?) for " name))
        ((cons? (car params)) (list (car (cdr (car params))) (car (car params))))
        (else (definstance_test name (cdr params)))))
(defn definstance_expand (xs)
  (let (name (car xs) params (car (cdr xs)) plain (map definstance_param params))
    `(def ,name
       (let (next# ,name)
         (lambda ,plain
           (if ,(definstance_test name params)
             (begin ,@(cdr (cdr xs)))
             (next# ,@plain)))))))
(defmacro definstance (lambda (xs) (definstance_expand xs)))

; (data_fields d) is the fields of d, as a list.
(defn data_fields (d)
  (letrec (from (lambda (i) (if (eq i (data_length d)) (quote ()) (cons (data_ref d i) (from (plus i 1))))))
    (from 0)))

; (fmap f x) applies f to each value x holds: the elements of a list or a
; vector, the values of a map, the value of a just or a right.
(defgeneric fmap (f x) x)
(definstance fmap (f (x list?)) (map f x))
(definstance fmap (f (x vector?)) (apply vector (map f (vector_to_list x))))
(definstance fmap (f (x map?))
  (apply hash_map (fold (lambda (acc kv) (cons (car kv) (cons (f (car (cdr kv))) acc)))
                        (quote ()) (map_to_list x))))
(definstance fmap (f (x maybe?)) (match x ((just v) (just (f v))) ((nothing) x)))
(definstance fmap (f (x either?)) (match x ((right v) (right (f v))) ((left _) x)))

; (show x) is x written as a string, as p prints it, but through show's
; instances for the values inside lists, vectors, maps and data.
(defn show_join (sep xs)
  (if (empty? xs) "" (fold (lambda (acc x) (str acc sep x)) (car xs) (cdr xs))))
(defn show (x)
  (let (s (str (list x))) (substring s 1 (- (string_length s) 1))))
(definstance show ((x cons?)) (str "(" (show_join " " (map show x)) ")"))
(definstance show ((x vector?)) (str "[" (show_join " " (map show (vector_to_list x))) "]"))
(definstance show ((x map?))
  (str "{" (show_join ", " (map (lambda (kv) (str (show (car kv)) " " (show (car (cdr kv))))) (map_to_list x))) "}"))
(definstance show ((x data?)) (str "#(" (show_join " " (cons (show (data_name x)) (map show (data_fields x)))) ")"))

; (compare a b) is -1, 0 or 1 as a sorts before, with or after b, two
; values of one type: numbers by value, strings and symbols by their
; characters, false before true, lists, vectors and data element by
; element (data by constructor name first, but nothing before just).
(defgeneric compare (a b) a)
(defn compare_by (less a b) (cond ((less a b) -1) ((less b a) 1) (else 0)))
(defn compare_lists (a b)
  (cond ((empty? a) (if (empty? b) 0 -1))
        ((empty? b) 1)
        (else (let (c (compare (car a) (car b))) (if (eq c 0) (compare_lists (cdr a) (cdr b)) c)))))
(definstance compare ((a number?) b) (compare_by < a b))
(definstance compare ((a string?) b) (compare_by string< a b))
(definstance compare ((a symbol?) b) (compare_by string< (str a) (str b)))
(definstance compare ((a boolean?) b) (compare (if a 1 0) (if b 1 0)))
(definstance compare ((a list?) b) (compare_lists a b))
(definstance compare ((a vector?) b) (compare_lists (vector_to_list a) (vector_to_list b)))
(definstance compare ((a data?) b) (compare_lists (cons (data_name a) (data_fields a)) (cons (data_name b) (data_fields b))))
(definstance compare ((a maybe?) b)
  (compare_lists (cons (just? a) (data_fields a)) (cons (just? b) (data_fields b))))

; (sort l) is l's elements in compare's order, and (sort_by cmp l) in the
; order of cmp, which gives -1, 0 or 1 as compare does. Both are stable:
; equal elements keep their order. A merge sort of runs, in constant stack.
(defn sort (l) (sort_by compare l))
(defn sort_by (cmp l) (sort_runs cmp (map list l)))
(defn sort_runs (cmp runs)
  (cond ((empty? runs) (quote ()))
        ((empty? (cdr runs)) (car runs))
        (else (sort_runs cmp (sort_pairs cmp runs (quote ()))))))
(defn sort_pairs (cmp runs acc)
  (cond ((empty? runs) (reverse acc))
        ((empty? (cdr runs)) (reverse (cons (car runs) acc)))
        (else (sort_pairs cmp (cdr (cdr runs))
                (cons (sort_merge cmp (car runs) (car (cdr runs)) (quote ())) acc)))))
(defn sort_merge (cmp a b acc)
  (cond ((empty? a) (append (reverse acc) b))
        ((empty? b) (append (reverse acc) a))
        ((> (cmp (car a) (car b)) 0) (sort_merge cmp a (cdr b) (cons (car b) acc)))
        (else (sort_merge cmp (cdr a) b (cons (car a) acc)))))

; Math functions, on floats (an integer argument is taken as a float).
; They are Go's math package's algorithms (from Cephes and FreeBSD's msun),
; written with the arithmetic builtins, so both backends compute the same
; float for each. The public names are the math_ functions, so that a
; program that defines its own log or abs doesn't change exp or expt.
(def pi 3.141592653589793)
(def math_inf (/ 1.0 0))
(defn math_nan? (x) (not (eq x x)))
(defn math_inf? (x) (or (eq x math_inf) (eq x (- math_inf))))
(defn math_abs (x) (if (< x 0.0) (- x) x))
(defn math_signbit (x) (or (< x 0.0) (and (eq x 0.0) (< (/ 1.0 x) 0.0))))
(defn math_copysign (v y) (if (math_signbit y) (- (math_abs v)) (math_abs v)))
; (math_poly x cs) is cs as a polynomial in x, highest power first.
(defn math_poly (x cs) (fold (lambda (acc c) (plus (* acc x) c)) (car cs) (cdr cs)))

; (math_frexp x), for a finite x > 0, is (m e): x = m * 2^e, 0.5 <= m < 1.
(defn math_frexp (x) (math_frexp_up x 0))
(defn math_frexp_up (x e)
  (cond ((>= x 18446744073709551616.0) (math_frexp_up (* x 5.421010862427522e-20) (plus e 64)))
        ((>= x 1.0) (math_frexp_up (* x 0.5) (plus e 1)))
        (else (math_frexp_down x e))))
(defn math_frexp_down (x e)
  (cond ((< x 5.421010862427522e-20) (math_frexp_down (* x 18446744073709551616.0) (- e 64)))
        ((< x 0.5) (math_frexp_down (* x 2.0) (- e 1)))
        (else (list x e))))
; (math_ldexp x e) is x * 2^e.
(defn math_ldexp (x e)
  (cond ((> e 1000) (math_ldexp (* x 1.0715086071862673e301) (- e 1000)))
        ((< e -1000) (math_ldexp (* x 9.332636185032189e-302) (plus e 1000)))
        ((< e 0) (/ x (math_pow2 (- e) 2.0 1.0)))
        (else (* x (math_pow2 e 2.0 1.0)))))
; (math_pow2 n b acc) is acc * b^n, by squaring.
(defn math_pow2 (n b acc)
  (if (eq n 0) acc
    (math_pow2 (/ n 2) (* b b) (if (eq (mod n 2) 1) (* acc b) acc))))

(def math_ln2_hi 6.93147180369123816490e-01)
(def math_ln2_lo 1.90821492927058770002e-10)

(defn math_exp (x)
  (let (x (float x))
    (cond ((math_nan? x) x)
          ((> x 7.09782712893383973096e+02) math_inf)
          ((< x -7.45133219101941108420e+02) 0.0)
          ((and (> x -3.725290298461914e-09) (< x 3.725290298461914e-09)) (plus 1.0 x))
          (else
            (let (k (if (< x 0.0)
                      (truncate (- (* 1.44269504088896338700e+00 x) 0.5))
                      (truncate (plus (* 1.44269504088896338700e+00 x) 0.5)))
                  hi (- x (* (float k) math_ln2_hi))
                  lo (* (float k) math_ln2_lo)
                  r (- hi lo)
                  t (* r r)
                  c (- r (* t (math_poly t (list 4.13813679705723846039e-08 -1.65339022054652515390e-06
                                                 6.61375632143793436117e-05 -2.77777777770155933842e-03
                                                 1.66666666666666657415e-01))))
                  y (- 1.0 (- (- lo (/ (* r c) (- 2.0 c))) hi)))
              (math_ldexp y k))))))
(def exp math_exp)

(defn math_log (x)
  (let (x (float x))
    (cond ((or (math_nan? x) (eq x math_inf)) x)
          ((< x 0.0) (/ 0.0 0))
          ((eq x 0.0) (- math_inf))
          (else
            (let (fe (math_frexp x)
                  low (< (car fe) 0.7071067811865476)
                  f (- (if low (* (car fe) 2.0) (car fe)) 1.0)
                  k (float (if low (- (car (cdr fe)) 1) (car (cdr fe))))
                  s (/ f (plus 2.0 f))
                  s2 (* s s)
                  s4 (* s2 s2)
                  t1 (* s2 (plus 6.666666666666735130e-01 (* s4 (plus 2.857142874366239149e-01
                           (* s4 (plus 1.818357216161805012e-01 (* s4 1.479819860511658591e-01)))))))
                  t2 (* s4 (plus 3.999999999940941908e-01 (* s4 (plus 2.222219843214978396e-01
                           (* s4 1.531383769920937332e-01)))))
                  hfsq (* (* 0.5 f) f))
              (- (* k math_ln2_hi) (- (- hfsq (plus (* s (plus hfsq (plus t1 t2))) (* k math_ln2_lo))) f)))))))
(def log math_log)

; (math_trig_reduce x), for a finite x >= 0, is (j z): x is about
; z + j*pi/4, j from 0 to 7. Below 2^29, Cody and Waite's reduction, with
; pi/4 in three parts; above, the exact one.
(defn math_trig_reduce (x)
  (if (>= x 536870912.0) (math_trig_reduce_exact x) (math_trig_reduce_near x)))
(defn math_trig_reduce_near (x)
  (let (w (* x 1.2732395447351628)
        y0 (if (< w 4503599627370496.0) (float (truncate w)) w)
        j0 (if (< y0 2305843009213693952.0) (mod (truncate y0) 8) 0)
        odd (eq (mod j0 2) 1)
        j (if odd (mod (plus j0 1) 8) j0)
        y (if odd (plus y0 1.0) y0))
    (list j (- (- (- x (* y 7.85398125648498535156e-1)) (* y 3.77489470793079817668e-8))
               (* y 2.69515142907905952645e-15)))))
; Exact argument reduction for large arguments, Go's trigReduce
; (Payne-Hanek): for x >= 2^29, x = ix * 2^exp with ix an integer of 53
; bits, and the product of ix with the bits of 4/pi from 2^(exp+61) on
; gives j (its integer part, mod 8) and the fraction z, with every bit
; Go's uses. glisp has no bit operations, so the numbers are lists of
; 24-bit limbs, lowest first, which no product overflows.
(def math_four_over_pi_bits (apply vector (list
  0 0 325 15927004 10258474 5503054 11510762 6929281
  11978027 3307655 2130940 10667863 12416906 12807752 14447748 10200512
  823901 13898659 2374140 3921465 6443854 8245508 7072349 7768329
  13842656 5073086 16548467 2337907 435827 15284488 12523387 15880310
  4190511 16759819 3153886 6169366 11801818 4119148 16621135 9835374
  10390654 13450431 13916906 5207439 14142434 16153102 7597844 10823124
  14153407 6438682 12193964 417933 16316119)))
(defn math_bn_pow2 (n) (if (eq n 0) 1 (* 2 (math_bn_pow2 (- n 1)))))
(defn math_bn_add (a b) (math_bn_add_carry a b 0))
(defn math_bn_add_carry (a b c)
  (if (and (empty? a) (empty? b))
    (if (eq c 0) (quote ()) (list c))
    (let (s (plus (if (empty? a) 0 (car a)) (if (empty? b) 0 (car b)) c))
      (cons (mod s 16777216)
            (math_bn_add_carry (if (empty? a) a (cdr a)) (if (empty? b) b (cdr b)) (/ s 16777216))))))
(defn math_bn_scale (a m) (math_bn_scale_carry a m 0))
(defn math_bn_scale_carry (a m c)
  (if (empty? a)
    (if (eq c 0) (quote ()) (list c))
    (let (p (plus (* (car a) m) c))
      (cons (mod p 16777216) (math_bn_scale_carry (cdr a) m (/ p 16777216))))))
(defn math_bn_mul (a b)
  (if (empty? b) (quote ())
    (math_bn_add (math_bn_scale a (car b)) (cons 0 (math_bn_mul a (cdr b))))))
(defn math_bn_drop (a n) (if (or (eq n 0) (empty? a)) a (math_bn_drop (cdr a) (- n 1))))
(defn math_bn_shr (a k) (math_bn_shr_bits (math_bn_drop a (/ k 24)) (math_bn_pow2 (mod k 24))))
(defn math_bn_shr_bits (a p)
  (if (empty? a) a
    (cons (plus (/ (car a) p) (* (mod (if (empty? (cdr a)) 0 (car (cdr a))) p) (/ 16777216 p)))
          (math_bn_shr_bits (cdr a) p))))
(defn math_bn_shl (a k)
  (if (< k 24) (math_bn_scale a (math_bn_pow2 k)) (cons 0 (math_bn_shl a (- k 24)))))
(defn math_bn_mod (a n)
  (cond ((empty? a) a)
        ((< n 24) (list (mod (car a) (math_bn_pow2 n))))
        (else (cons (car a) (math_bn_mod (cdr a) (- n 24))))))
(defn math_bn_to_int (a) (if (empty? a) 0 (plus (car a) (* 16777216 (math_bn_to_int (cdr a))))))
(defn math_bn_of_int (n) (if (eq n 0) (quote ()) (cons (mod n 16777216) (math_bn_of_int (/ n 16777216)))))
(defn math_bn_bitlen (a)
  (if (empty? a) 0
    (let (rest (math_bn_bitlen (cdr a)))
      (if (> rest 0) (plus rest 24) (math_bn_int_bitlen (car a))))))
(defn math_bn_int_bitlen (n) (if (eq n 0) 0 (plus 1 (math_bn_int_bitlen (/ n 2)))))
; The limbs of 4/pi's bits from limb i to limb last, as a number.
(defn math_four_over_pi_limbs (i last)
  (if (> i last) (quote ())
    (append (math_four_over_pi_limbs (plus i 1) last) (list (vector_ref math_four_over_pi_bits i)))))
(defn math_trig_reduce_exact (x)
  (let (fe (math_frexp x)
        ix (math_bn_of_int (truncate (* (car fe) 9007199254740992.0)))
        s (plus (- (car (cdr fe)) 53) 61)
        last (/ (plus s 191) 24)
        w (math_bn_mod (math_bn_shr (math_four_over_pi_limbs (/ s 24) last) (- (* 24 (plus last 1)) (plus s 192))) 192)
        r (math_bn_mod (math_bn_shr (math_bn_mul w ix) 64) 128)
        j (math_bn_to_int (math_bn_shr r 125))
        hi (math_bn_shr (math_bn_mod r 125) 61)
        b (math_bn_bitlen hi)
        ; Go fills the bits below hi's from the top of the low word, not
        ; from the bits after hi's: the same here.
        word (math_bn_add (math_bn_shl (math_bn_mod hi (- b 1)) (- 65 b)) (math_bn_shr (math_bn_mod r 64) (- b 1)))
        z (if (eq b 0) 0.0
            (math_ldexp (float (plus 4503599627370496 (math_bn_to_int (math_bn_shr word 12)))) (- b 117)))
        odd (eq (mod j 2) 1))
    (list (if odd (mod (plus j 1) 8) j) (* (if odd (- z 1.0) z) 0.7853981633974483))))
(def math_sin_coefficients
  (list 1.58962301576546568060e-10 -2.50507477628578072866e-8 2.75573136213857245213e-6
        -1.98412698295895385996e-4 8.33333333332211858878e-3 -1.66666666666666307295e-1))
(def math_cos_coefficients
  (list -1.13585365213876817300e-11 2.08757008419747316778e-9 -2.75573141792967388112e-7
        2.48015872888517045348e-5 -1.38888888888730564116e-3 4.16666666666665929218e-2))
(defn math_sin_part (z zz) (plus z (* (* z zz) (math_poly zz math_sin_coefficients))))
(defn math_cos_part (zz) (plus (- 1.0 (* 0.5 zz)) (* (* zz zz) (math_poly zz math_cos_coefficients))))

(defn math_sin (x)
  (let (x (float x))
    (cond ((or (eq x 0.0) (math_nan? x)) x)
          ((math_inf? x) (/ 0.0 0))
          (else
            (let (jz (math_trig_reduce (math_abs x))
                  j (if (> (car jz) 3) (- (car jz) 4) (car jz))
                  negative (if (> (car jz) 3) (not (< x 0.0)) (< x 0.0))
                  z (car (cdr jz))
                  y (if (or (eq j 1) (eq j 2)) (math_cos_part (* z z)) (math_sin_part z (* z z))))
              (if negative (- y) y))))))
(def sin math_sin)

(defn math_cos (x)
  (let (x (float x))
    (if (or (math_nan? x) (math_inf? x)) (/ 0.0 0)
      (let (jz (math_trig_reduce (math_abs x))
            high (> (car jz) 3)
            j (if high (- (car jz) 4) (car jz))
            negative (if (> j 1) (not high) high)
            z (car (cdr jz))
            y (if (or (eq j 1) (eq j 2)) (math_sin_part z (* z z)) (math_cos_part (* z z))))
        (if negative (- y) y)))))
(def cos math_cos)

(defn math_tan (x)
  (let (x (float x))
    (cond ((or (eq x 0.0) (math_nan? x)) x)
          ((math_inf? x) (/ 0.0 0))
          (else
            (let (jz (math_trig_reduce (math_abs x))
                  z (car (cdr jz))
                  zz (* z z)
                  y0 (if (> zz 1e-14)
                       (plus z (* z (/ (* zz (math_poly zz (list -1.30936939181383777646e4
                                                                 1.15351664838587416140e6
                                                                 -1.79565251976484877988e7)))
                                       (math_poly zz (list 1.0 1.36812963470692954678e4
                                                           -1.32089234440210967447e6
                                                           2.50083801823357915839e7
                                                           -5.38695755929454629881e7)))))
                       z)
                  y (if (eq (mod (/ (car jz) 2) 2) 1) (/ -1.0 y0) y0))
              (if (< x 0.0) (- y) y))))))
(def tan math_tan)

(defn math_xatan (x)
  (let (z (* x x)
        r (/ (* z (math_poly z (list -8.750608600031904122785e-01 -1.615753718733365076637e+01
                                     -7.500855792314704667340e+01 -1.228866684490136173410e+02
                                     -6.485021904942025371773e+01)))
             (math_poly z (list 1.0 2.485846490142306297962e+01 1.650270098316988542046e+02
                                4.328810604912902668951e+02 4.853903996359136964868e+02
                                1.945506571482613964425e+02))))
    (plus (* x r) x)))
(defn math_satan (x)
  (cond ((<= x 0.66) (math_xatan x))
        ((> x 2.41421356237309504880)
         (plus (- 1.5707963267948966 (math_xatan (/ 1.0 x))) 6.123233995736765886130e-17))
        (else (plus (plus 0.7853981633974483 (math_xatan (/ (- x 1.0) (plus x 1.0))))
                    3.061616997868383e-17))))
(defn math_atan (x)
  (let (x (float x))
    (cond ((eq x 0.0) x)
          ((> x 0.0) (math_satan x))
          (else (- (math_satan (- x)))))))
(def atan math_atan)

(defn math_asin (x)
  (let (x (float x) a (math_abs x))
    (cond ((eq x 0.0) x)
          ((> a 1.0) (/ 0.0 0))
          (else
            (let (temp (sqrt (- 1.0 (* a a)))
                  r (if (> a 0.7) (- 1.5707963267948966 (math_satan (/ temp a))) (math_satan (/ a temp))))
              (if (< x 0.0) (- r) r))))))
(def asin math_asin)
(defn acos (x) (- 1.5707963267948966 (math_asin x)))

(defn math_atan2 (y x)
  (let (y (float y) x (float x))
    (cond ((or (math_nan? y) (math_nan? x)) (/ 0.0 0))
          ((eq y 0.0) (if (and (>= x 0.0) (not (math_signbit x))) (math_copysign 0.0 y) (math_copysign pi y)))
          ((eq x 0.0) (math_copysign 1.5707963267948966 y))
          ((eq x math_inf) (math_copysign (if (math_inf? y) 0.7853981633974483 0.0) y))
          ((eq x (- math_inf)) (math_copysign (if (math_inf? y) 2.356194490192345 pi) y))
          ((math_inf? y) (math_copysign 1.5707963267948966 y))
          (else
            (let (q (math_atan (/ y x)))
              (cond ((>= x 0.0) q)
                    ((<= q 0.0) (plus q pi))
                    (else (- q pi))))))))
(def atan2 math_atan2)

; (expt x y) is x to the power y: an integer for integers with y >= 0
; (wrapping as integer arithmetic does), a float otherwise.
(defn expt (x y)
  (if (and (integer? x) (integer? y) (>= y 0))
    (math_pow2 y x 1)
    (math_pow (float x) (float y))))
(defn math_odd_integer? (y)
  (and (< (math_abs y) 9007199254740992.0) (eq y (float (truncate y))) (not (eq (mod (truncate y) 2) 0))))
(defn math_pow (x y)
  (cond ((or (eq y 0.0) (eq x 1.0)) 1.0)
        ((eq y 1.0) x)
        ((or (math_nan? x) (math_nan? y)) (/ 0.0 0))
        ((eq x 0.0)
         (if (< y 0.0)
           (if (and (math_signbit x) (math_odd_integer? y)) (- math_inf) math_inf)
           (if (and (math_signbit x) (math_odd_integer? y)) x 0.0)))
        ((math_inf? y)
         (cond ((eq x -1.0) 1.0)
               ((eq (< (math_abs x) 1.0) (> y 0.0)) 0.0)
               (else math_inf)))
        ((eq x (- math_inf)) (math_pow (/ 1.0 x) (- y)))
        ((eq x math_inf) (if (< y 0.0) 0.0 math_inf))
        ((eq y 0.5) (sqrt x))
        ((eq y -0.5) (/ 1.0 (sqrt x)))
        (else (math_pow_finite x y))))
(defn math_pow_finite (x y)
  (let (ay (math_abs y)
        whole (if (< ay 4611686018427387904.0) (float (truncate ay)) ay)
        fraction (- ay whole))
    (cond ((and (not (eq fraction 0.0)) (< x 0.0)) (/ 0.0 0))
          ((>= whole 4611686018427387904.0)
           (cond ((eq x -1.0) 1.0)
                 ((eq (< (math_abs x) 1.0) (> y 0.0)) 0.0)
                 (else math_inf)))
          (else
            (let (up (> fraction 0.5)
                  yf (if up (- fraction 1.0) fraction)
                  yi (if up (plus (truncate whole) 1) (truncate whole))
                  a1 (if (eq yf 0.0) 1.0 (math_exp (* yf (math_log x))))
                  fe (math_frexp (math_abs x))
                  x1 (if (< x 0.0) (- (car fe)) (car fe))
                  r (math_pow_loop yi x1 (car (cdr fe)) a1 0))
              (if (< y 0.0)
                (math_ldexp (/ 1.0 (car r)) (- (car (cdr r))))
                (math_ldexp (car r) (car (cdr r)))))))))
; (math_pow_loop i x1 xe a1 ae) multiplies a1 * 2^ae by (x1 * 2^xe)^i, by
; squaring, keeping the exponents apart so nothing overflows.
(defn math_pow_loop (i x1 xe a1 ae)
  (cond ((eq i 0) (list a1 ae))
        ((or (< xe -4096) (> xe 4096)) (list a1 (plus ae xe)))
        (else
          (let (odd (eq (mod i 2) 1)
                x2 (* x1 x1)
                small (< x2 0.5))
            (math_pow_loop (/ i 2) (if small (plus x2 x2) x2) (if small (- (* xe 2) 1) (* xe 2))
                           (if odd (* a1 x1) a1) (if odd (plus ae xe) ae))))))
